{
  "backend": {
    "name": "github",
    "repo": "Sai-Deepan/cato_blog",
    "branch": "master"
  },
  "local_backend": {
    "url": "http://127.0.0.1:8081/api/v1"
  },
  "load_config_file": false,
  "media_folder": "static/images/uploads",
  "public_folder": "/images/uploads",
  "slug": {
    "encoding": "ascii",
    "clean_accents": true,
    "sanitize_replacement": "-"
  },
  "collections": [
    {
      "name": "blog",
      "label": "Blog",
      "folder": "content/blog",
      "create": true,
      "delete": false,
      "extension": "md",
      "format": "yaml-frontmatter",
      "slug": "{{slug}}",
      "preview_path": "blog/{{slug}}/",
      "filter": {
        "field": "cms_entry",
        "value": true
      },
      "summary": "{{title}}",
      "fields": [
        {
          "name": "cms_entry",
          "label": "Entry",
          "widget": "hidden",
          "default": true
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "description",
          "label": "Short description",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "Date",
          "widget": "datetime",
          "required": false
        },
        {
          "name": "draft",
          "label": "Keep as draft",
          "widget": "boolean",
          "default": true,
          "required": false,
          "hint": "Turn off when the post is ready for the public website. Local saves do not deploy the live site."
        },
        {
          "name": "cover",
          "label": "Cover image",
          "widget": "image",
          "required": false,
          "allow_multiple": false
        },
        {
          "name": "cover_alt",
          "label": "Cover image description",
          "widget": "string",
          "required": false
        },
        {
          "name": "category",
          "label": "Topic",
          "widget": "string",
          "default": "notes"
        },
        {
          "name": "subtitle",
          "label": "Subtitle",
          "widget": "string",
          "required": false
        },
        {
          "name": "featured",
          "label": "Featured",
          "widget": "boolean",
          "default": false,
          "required": false
        },
        {
          "name": "tags",
          "label": "Tags",
          "widget": "list",
          "required": false
        },
        {
          "name": "body",
          "label": "Write-up",
          "widget": "richtext",
          "required": false,
          "modes": [
            "rich_text",
            "raw"
          ],
          "editor_components": [
            "image",
            "code-block"
          ],
          "hint": "Use Heading 2 for sections. Upload images using the image control; include descriptive alt text."
        }
      ]
    },
    {
      "name": "articles",
      "label": "Articles",
      "folder": "content/articles",
      "create": true,
      "delete": false,
      "extension": "md",
      "format": "yaml-frontmatter",
      "slug": "{{slug}}",
      "preview_path": "articles/{{slug}}/",
      "filter": {
        "field": "cms_entry",
        "value": true
      },
      "summary": "{{title}}",
      "fields": [
        {
          "name": "cms_entry",
          "label": "Entry",
          "widget": "hidden",
          "default": true
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "description",
          "label": "Short description",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "Date",
          "widget": "datetime",
          "required": false
        },
        {
          "name": "draft",
          "label": "Keep as draft",
          "widget": "boolean",
          "default": true,
          "required": false,
          "hint": "Turn off when the post is ready for the public website. Local saves do not deploy the live site."
        },
        {
          "name": "image",
          "label": "Cover image",
          "widget": "image",
          "required": false,
          "allow_multiple": false
        },
        {
          "name": "cover_alt",
          "label": "Cover image description",
          "widget": "string",
          "required": false
        },
        {
          "name": "category",
          "label": "Category",
          "widget": "string",
          "required": false
        },
        {
          "name": "featured",
          "label": "Featured",
          "widget": "boolean",
          "default": false,
          "required": false
        },
        {
          "name": "time",
          "label": "Reading time override",
          "widget": "string",
          "required": false,
          "hint": "Optional, e.g. 8 min. The write-up calculates reading time automatically."
        },
        {
          "name": "tags",
          "label": "Tags",
          "widget": "list",
          "required": false
        },
        {
          "name": "body",
          "label": "Write-up",
          "widget": "richtext",
          "required": false,
          "modes": [
            "rich_text",
            "raw"
          ],
          "editor_components": [
            "image",
            "code-block"
          ],
          "hint": "Use Heading 2 for sections. Upload images using the image control; include descriptive alt text."
        }
      ]
    },
    {
      "name": "exploits",
      "label": "Exploits",
      "folder": "content/exploits",
      "create": true,
      "delete": false,
      "extension": "md",
      "format": "yaml-frontmatter",
      "slug": "{{slug}}",
      "preview_path": "exploits/{{slug}}/",
      "filter": {
        "field": "cms_entry",
        "value": true
      },
      "summary": "{{title}}",
      "fields": [
        {
          "name": "cms_entry",
          "label": "Entry",
          "widget": "hidden",
          "default": true
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "description",
          "label": "Short description",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "Date",
          "widget": "datetime",
          "required": false
        },
        {
          "name": "draft",
          "label": "Keep as draft",
          "widget": "boolean",
          "default": true,
          "required": false,
          "hint": "Turn off when the post is ready for the public website. Local saves do not deploy the live site."
        },
        {
          "name": "cover",
          "label": "Cover image",
          "widget": "image",
          "required": false,
          "allow_multiple": false
        },
        {
          "name": "cover_alt",
          "label": "Cover image description",
          "widget": "string",
          "required": false
        },
        {
          "name": "platform",
          "label": "Platform",
          "widget": "string",
          "default": "Other"
        },
        {
          "name": "research_type",
          "label": "Type of research",
          "widget": "string",
          "default": "Research note"
        },
        {
          "name": "cve",
          "label": "CVE identifier",
          "widget": "string",
          "required": false
        },
        {
          "name": "disclosure",
          "label": "Disclosure status",
          "widget": "string",
          "required": false
        },
        {
          "name": "tags",
          "label": "Tags",
          "widget": "list",
          "required": false
        },
        {
          "name": "body",
          "label": "Write-up",
          "widget": "richtext",
          "required": false,
          "modes": [
            "rich_text",
            "raw"
          ],
          "editor_components": [
            "image",
            "code-block"
          ],
          "hint": "Use Heading 2 for sections. Upload images using the image control; include descriptive alt text."
        }
      ]
    },
    {
      "name": "research",
      "label": "Research",
      "folder": "content/research",
      "create": true,
      "delete": false,
      "extension": "md",
      "format": "yaml-frontmatter",
      "slug": "{{slug}}",
      "preview_path": "research/{{slug}}/",
      "filter": {
        "field": "cms_entry",
        "value": true
      },
      "summary": "{{title}}",
      "fields": [
        {
          "name": "cms_entry",
          "label": "Entry",
          "widget": "hidden",
          "default": true
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "publication_type",
          "label": "Publication format",
          "widget": "select",
          "required": true,
          "default": "research",
          "options": [
            {
              "label": "Paper",
              "value": "paper"
            },
            {
              "label": "Patent",
              "value": "patent"
            },
            {
              "label": "Write-up",
              "value": "writeup"
            },
            {
              "label": "General research",
              "value": "research"
            }
          ]
        },
        {
          "name": "status",
          "label": "Status",
          "widget": "select",
          "required": false,
          "options": [
            "Published",
            "Preprint",
            "Under review",
            "Application published",
            "Granted",
            "In progress",
            "Completed"
          ],
          "hint": "Use the actual status of the work. Leave blank if it does not apply."
        },
        {
          "name": "authors",
          "label": "Authors / inventors",
          "widget": "list",
          "required": false,
          "hint": "Add authors in the order shown on the publication."
        },
        {
          "name": "venue",
          "label": "Journal, conference, or patent office",
          "widget": "string",
          "required": false
        },
        {
          "name": "identifier",
          "label": "Patent or publication number",
          "widget": "string",
          "required": false
        },
        {
          "name": "doi",
          "label": "DOI",
          "widget": "string",
          "required": false,
          "hint": "Identifier only, for example 10.1234/example. Do not include https://doi.org/."
        },
        {
          "name": "description",
          "label": "Short description",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "Date",
          "widget": "datetime",
          "required": false
        },
        {
          "name": "draft",
          "label": "Keep as draft",
          "widget": "boolean",
          "default": true,
          "required": false,
          "hint": "Turn off when the post is ready for the public website. Local saves do not deploy the live site."
        },
        {
          "name": "cover",
          "label": "Cover image",
          "widget": "image",
          "required": false,
          "allow_multiple": false
        },
        {
          "name": "cover_alt",
          "label": "Cover image description",
          "widget": "string",
          "required": false
        },
        {
          "name": "tags",
          "label": "Tags",
          "widget": "list",
          "required": false
        },
        {
          "name": "abstract",
          "label": "Abstract",
          "widget": "text",
          "required": false
        },
        {
          "name": "publication_url",
          "label": "Original publication URL",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https://.+",
            "Use a complete HTTPS URL."
          ]
        },
        {
          "name": "pdf",
          "label": "Publication PDF",
          "widget": "file",
          "required": false,
          "hint": "Upload the PDF or select one from the media library."
        },
        {
          "name": "code_url",
          "label": "Code repository URL",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https://.+",
            "Use a complete HTTPS URL."
          ]
        },
        {
          "name": "citation",
          "label": "Citation / BibTeX",
          "widget": "text",
          "required": false,
          "hint": "Paste the exact citation or BibTeX entry. Visitors can copy it from the record page."
        },
        {
          "name": "body",
          "label": "Write-up",
          "widget": "richtext",
          "required": false,
          "modes": [
            "rich_text",
            "raw"
          ],
          "editor_components": [
            "image",
            "code-block"
          ],
          "hint": "Use Heading 2 for sections. Upload images using the image control; include descriptive alt text."
        }
      ]
    },
    {
      "name": "cves",
      "label": "CVEs",
      "folder": "content/cves",
      "create": true,
      "delete": false,
      "extension": "md",
      "format": "yaml-frontmatter",
      "slug": "{{slug}}",
      "preview_path": "cves/{{slug}}/",
      "filter": {
        "field": "cms_entry",
        "value": true
      },
      "summary": "{{title}}",
      "fields": [
        {
          "name": "cms_entry",
          "label": "Entry",
          "widget": "hidden",
          "default": true
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "cve_id",
          "label": "CVE identifier",
          "widget": "string",
          "required": false,
          "pattern": [
            "^CVE-[0-9]{4}-[0-9]{4,}$",
            "Use a CVE identifier such as CVE-2026-12345."
          ],
          "hint": "Leave blank if no identifier is assigned. Do not enter a placeholder."
        },
        {
          "name": "cve_status",
          "label": "CVE record status",
          "widget": "select",
          "required": false,
          "options": [
            "Published",
            "Reserved",
            "Rejected",
            "Not specified"
          ],
          "default": "Not specified"
        },
        {
          "name": "severity",
          "label": "Severity",
          "widget": "select",
          "required": false,
          "options": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "None",
            "Unscored"
          ],
          "default": "Unscored"
        },
        {
          "name": "cvss_score",
          "label": "CVSS score",
          "widget": "string",
          "required": false,
          "pattern": [
            "^(10(\\.0)?|[0-9](\\.[0-9])?)$",
            "Enter a score from 0.0 to 10.0."
          ],
          "hint": "Enter the source score; no score is inferred from severity."
        },
        {
          "name": "cvss_version",
          "label": "CVSS version",
          "widget": "string",
          "required": false
        },
        {
          "name": "cvss_vector",
          "label": "CVSS vector",
          "widget": "string",
          "required": false
        },
        {
          "name": "score_source",
          "label": "Scoring source",
          "widget": "string",
          "required": false
        },
        {
          "name": "cwe",
          "label": "CWE identifier",
          "widget": "string",
          "required": false
        },
        {
          "name": "product",
          "label": "Affected product",
          "widget": "string",
          "required": false
        },
        {
          "name": "vendor",
          "label": "Vendor",
          "widget": "string",
          "required": false
        },
        {
          "name": "affected_versions",
          "label": "Affected versions",
          "widget": "string",
          "required": false
        },
        {
          "name": "fixed_versions",
          "label": "Fixed versions",
          "widget": "string",
          "required": false
        },
        {
          "name": "remediation_status",
          "label": "Remediation status",
          "widget": "select",
          "required": false,
          "options": [
            "Fixed",
            "Mitigated",
            "Investigating",
            "No fix recorded",
            "Not specified"
          ],
          "default": "Not specified"
        },
        {
          "name": "description",
          "label": "Short description",
          "widget": "text",
          "required": false
        },
        {
          "name": "date",
          "label": "Date",
          "widget": "datetime",
          "required": false
        },
        {
          "name": "draft",
          "label": "Keep as draft",
          "widget": "boolean",
          "default": true,
          "required": false,
          "hint": "Turn off when the post is ready for the public website. Local saves do not deploy the live site."
        },
        {
          "name": "cover",
          "label": "Cover image",
          "widget": "image",
          "required": false,
          "allow_multiple": false
        },
        {
          "name": "cover_alt",
          "label": "Cover image description",
          "widget": "string",
          "required": false
        },
        {
          "name": "tags",
          "label": "Tags",
          "widget": "list",
          "required": false
        },
        {
          "name": "impact",
          "label": "Impact summary",
          "widget": "text",
          "required": false
        },
        {
          "name": "mitigation",
          "label": "Remediation and mitigation",
          "widget": "text",
          "required": false
        },
        {
          "name": "record_url",
          "label": "Official CVE record URL",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https://.+",
            "Use a complete HTTPS URL."
          ]
        },
        {
          "name": "vendor_url",
          "label": "Vendor advisory URL",
          "widget": "string",
          "required": false,
          "pattern": [
            "^https://.+",
            "Use a complete HTTPS URL."
          ]
        },
        {
          "name": "timeline",
          "label": "Disclosure timeline",
          "widget": "list",
          "required": false,
          "fields": [
            {
              "name": "date",
              "label": "Date or date label",
              "widget": "string",
              "required": false
            },
            {
              "name": "event",
              "label": "Event",
              "widget": "text",
              "required": true
            }
          ]
        },
        {
          "name": "references",
          "label": "References",
          "widget": "list",
          "required": false,
          "fields": [
            {
              "name": "label",
              "label": "Link label",
              "widget": "string",
              "required": true
            },
            {
              "name": "url",
              "label": "URL",
              "widget": "string",
              "required": true,
              "pattern": [
                "^https://.+",
                "Use a complete HTTPS URL."
              ]
            }
          ]
        },
        {
          "name": "body",
          "label": "Write-up",
          "widget": "richtext",
          "required": false,
          "modes": [
            "rich_text",
            "raw"
          ],
          "editor_components": [
            "image",
            "code-block"
          ],
          "hint": "Use Heading 2 for sections. Upload images using the image control; include descriptive alt text."
        }
      ]
    }
  ]
}
